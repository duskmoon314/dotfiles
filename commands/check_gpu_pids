#!/bin/bash

check_gpu_pids() {
  local __usage="
Usage: check_gpu_pids [OPTIONS]
"

  if ! command_exists nvidia-smi; then
    ERROR "nvidia-smi is not found"
    return 1
  fi

  if ! command_exists docker; then
    ERROR "docker is not found"
    return 1
  fi

  local gpu_pids
  gpu_pids=$(nvidia-smi --query-compute-apps=pid --format=csv,noheader,nounits)

  if [ -z "$gpu_pids" ]; then
    INFO "No GPU processes are running"
    return 0
  fi

  local container_ids
  container_ids=$(docker ps --format '{{.ID}}')

  local remaining_gpu_pids=$gpu_pids

  for cid in $container_ids; do
    local container_pids
    container_pids=$(docker top "$cid" -eo pid | awk 'NR>1')
    local container_name
    container_name=$(docker inspect --format '{{.Name}}' "$cid" | cut -c2-)

    for pid in $gpu_pids; do
      if contains "$container_pids" "$pid"; then
        INFO "PID $pid belongs to container $container_name"
        remaining_gpu_pids=${remaining_gpu_pids//$pid/}
      fi
    done
  done

  for pid in $remaining_gpu_pids; do
    WARN "PID $pid does not belong to any container"
  done
}
